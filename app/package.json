{
  "name": "@bottap/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist -o dist/bottap.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@bottap/shared": "*",
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
