# Telegram API credentials from https://my.telegram.org (required for live MTProto mode)
TG_API_ID=
TG_API_HASH=

# Comma-separated bot usernames allowed to appear on the glasses (without @)
BOTTAP_ALLOWLIST=uptime_ops_bot,deploy_gate_bot

# Gateway server configuration
BOTTAP_HOST=0.0.0.0
BOTTAP_PORT=8788
BOTTAP_DATA_DIR=./data

# Optional bearer token required by the companion app & glasses WebView (recommended outside localhost)
BOTTAP_TOKEN=

# Set to "demo" to run the built-in offline scenario transport instead of live MTProto
BOTTAP_MODE=live

# Allowed CORS origin(s), comma-separated or "*" for LAN/Even Hub WebView testing
BOTTAP_CORS_ORIGIN=*
