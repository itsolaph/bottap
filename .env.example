# Telegram API credentials from https://my.telegram.org (required for live MTProto mode)
TG_API_ID=
TG_API_HASH=

# Comma-separated bot usernames allowed to appear on the glasses (without @)
BOTTAP_ALLOWLIST=uptime_ops_bot,deploy_gate_bot

# Gateway server configuration (loopback by default; place behind Caddy/Tailscale/Tunnel HTTPS for remote access)
BOTTAP_HOST=127.0.0.1
BOTTAP_BIND_HOST=127.0.0.1
BOTTAP_PORT=8788
BOTTAP_DATA_DIR=./data

# Bearer token (>=12 chars) — REQUIRED when binding live mode on a non-loopback host or inside Docker
BOTTAP_TOKEN=

# Set to "demo" to run the built-in offline scenario transport instead of live MTProto
BOTTAP_MODE=live

# Explicit comma-separated allowed CORS origins (leave empty for same-origin only; never wildcard in production)
BOTTAP_CORS_ORIGIN=

# Optional: BotFather token for running the live Telegram demo alert bot (npm run demo:bot)
DEMO_BOT_TOKEN=
